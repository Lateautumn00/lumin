{
  "name": "@lumin/tool-text-toolbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./manifest": {
      "types": "./src/manifest.ts",
      "default": "./src/manifest.ts"
    },
    "./renderer/*": {
      "types": "./src/renderer/*",
      "default": "./src/renderer/*"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@lucide/vue": "1.72.0",
    "@lumin/plugin-api": "workspace:*",
    "@lumin/shared": "workspace:*",
    "naive-ui": "2.45.3",
    "pinyin-pro": "3.29.5",
    "vue": "3.5.45"
  }
}
