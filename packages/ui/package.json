{
  "name": "@lumin/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./markdown": {
      "types": "./src/markdown.ts",
      "default": "./src/markdown.ts"
    },
    "./create-editor": {
      "types": "./src/create-editor.ts",
      "default": "./src/create-editor.ts"
    },
    "./*": {
      "types": "./src/*",
      "default": "./src/*"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lucide/vue": "1.72.0",
    "@lumin/plugin-api": "workspace:*",
    "marked": "18.2.1",
    "naive-ui": "2.45.3",
    "vue": "3.5.45"
  }
}
