{
  "name": "@lumin/tool-media-convert",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./manifest": {
      "types": "./src/manifest.ts",
      "default": "./src/manifest.ts"
    },
    "./node": {
      "types": "./src/node.ts",
      "default": "./src/node.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./src/schema.ts"
    },
    "./errors": {
      "types": "./src/errors.ts",
      "default": "./src/errors.ts"
    },
    "./encode": {
      "types": "./src/encode.ts",
      "default": "./src/encode.ts"
    },
    "./compat": {
      "types": "./src/compat.ts",
      "default": "./src/compat.ts"
    },
    "./media": {
      "types": "./src/media.ts",
      "default": "./src/media.ts"
    },
    "./naming": {
      "types": "./src/naming.ts",
      "default": "./src/naming.ts"
    },
    "./renderer/*": {
      "types": "./src/renderer/*",
      "default": "./src/renderer/*"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@lucide/vue": "1.72.0",
    "@lumin/node-kit": "workspace:*",
    "@lumin/plugin-api": "workspace:*",
    "@lumin/shared": "workspace:*",
    "@lumin/ui": "workspace:*",
    "naive-ui": "2.45.3",
    "vue": "3.5.45",
    "zod": "4.6.7"
  }
}
