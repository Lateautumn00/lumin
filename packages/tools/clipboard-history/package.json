{
  "name": "@lumin/tool-clipboard-history",
  "version": "0.0.0",
  "private": true,
  "description": "剪贴板历史工具（Lumin）",
  "type": "module",
  "exports": {
    ".": "./src/manifest.ts",
    "./manifest": "./src/manifest.ts",
    "./node": "./src/node.ts",
    "./renderer/*": "./src/renderer/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@lucide/vue": "1.72.0",
    "@lumin/node-kit": "workspace:*",
    "@lumin/plugin-api": "workspace:*",
    "@lumin/shared": "workspace:*",
    "naive-ui": "2.45.3",
    "vue": "3.5.45",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "electron": "45.3.1"
  }
}
